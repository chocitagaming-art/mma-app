# Public site URL, no trailing slash (e.g. https://example.com). Single source of
# truth for sitemap.xml, robots.txt and metadataBase/canonical tags.
# Deliberately NOT prefixed with NEXT_PUBLIC_: prefixed vars are inlined at build
# time, so changing the domain would require a rebuild. All three consumers are
# server-only, so this is read at runtime instead.
# Falls back to the Vercel domain when unset (see src/lib/site-url.ts).
SITE_URL=

# Postgres connection string (Neon)
DATABASE_URL=your_connection_string

# Anthropic API key for AI predictions / maestro
ANTHROPIC_API_KEY=

# External prediction microservice base URL
PREDICTION_SERVICE_URL=

# API key for the prediction microservice
PREDICTION_SERVICE_API_KEY=

# YouTube Data API key for fight video lookups
YOUTUBE_API_KEY=

# Bearer token for POST /api/revalidate (on-demand home revalidation)
REVALIDATE_SECRET=

# Upstash Redis (REST) for the distributed rate limiter. Optional in local dev:
# when absent, src/lib/rate-limit.ts silently falls back to an in-memory limiter,
# which is per-instance and therefore useless once Vercel scales out. Set both in
# production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clave del panel de estado (/estado y /api/estado). Sin ella el panel no
# existe para nadie: falla cerrado a proposito. Debe coincidir EXACTAMENTE con
# el secreto ESTADO_KEY del repo mma-ingesta, que es de donde la lee el
# guardian que abre el aviso cuando algo se rompe.
ESTADO_KEY=
