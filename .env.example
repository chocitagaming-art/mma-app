# Postgres connection string (Neon)
DATABASE_URL=your_connection_string

# Anthropic API key for AI predictions / maestro
ANTHROPIC_API_KEY=

# External prediction microservice base URL
PREDICTION_SERVICE_URL=

# API key for the prediction microservice
PREDICTION_SERVICE_API_KEY=

# YouTube Data API key for fight video lookups
YOUTUBE_API_KEY=

# Bearer token for POST /api/revalidate (on-demand home revalidation)
REVALIDATE_SECRET=

# Upstash Redis (REST) for the distributed rate limiter. Optional in local dev:
# when absent, src/lib/rate-limit.ts silently falls back to an in-memory limiter,
# which is per-instance and therefore useless once Vercel scales out. Set both in
# production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
